#!/usr/bin/env bash
#
# .compy/build -- emit the shipped Compy projects from this
# single source repo (the .compy/build convention).
#
# Invoked by the host build as:
#     cd <repo> && .compy/build <out-dir>
# with an absolute, fresh <out-dir>. It populates
#     <out-dir>/easy/   and   <out-dir>/mygame/
# each a valid Compy project (a direct main.lua), named
# exactly as its manifest entry. Works relative to its own
# location, is deterministic, and needs no network.
#
# Both share engine.lua and differ in the rest: easy has one
# color list and plain lists of heroes and foods; mygame gives
# each picture colors of its own and lets a hero or food name
# point at any picture. mygame's main.lua is empty: a student
# types every line of their own game, the require included.
#
set -eu

SRC="$(cd "$(dirname "$0")/.." && pwd)"
OUT="${1:?usage: .compy/build <out-dir> (absolute, fresh)}"

emit_easy() {
  local d="$OUT/easy"
  mkdir -p "$d"
  cp "$SRC"/easy/*.lua "$SRC/engine.lua" "$SRC/LICENSE" "$SRC/README.md" "$d/"
}

emit_mygame() {
  local d="$OUT/mygame"
  mkdir -p "$d"
  cp "$SRC"/mygame/*.lua "$SRC/engine.lua" "$SRC/LICENSE" "$d/"
}

emit_easy
emit_mygame
echo "emitted $OUT/easy $OUT/mygame" >&2
